{
  "name": "shine-notes-backend",
  "version": "1.0.0",
  "description": "This directory will contain the Notes App backend.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "cross-env NODE_ENV=test node --import tsx ./node_modules/mocha/bin/mocha.js \"test/**/*.test.ts\"",
    "test:coverage": "cd .. && cross-env NODE_ENV=test c8 --config backend/.c8rc.json node --import ./backend/node_modules/tsx/dist/loader.mjs ./backend/node_modules/mocha/bin/mocha.js \"backend/test/**/*.test.ts\""
  },
  "keywords": [
    "notes",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Arfa Riaz",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sanitize-html": "2.17.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "c8": "12.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "mongodb-memory-server": "^11.2.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.5"
  }
}
