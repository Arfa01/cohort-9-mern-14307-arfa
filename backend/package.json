{
  "name": "shine-notes-backend",
  "version": "1.0.0",
  "description": "This directory will contain the Notes App backend.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "NODE_ENV=test node --import tsx ./node_modules/mocha/bin/mocha.js \"test/**/*.test.ts\""
  },
  "keywords": [
    "notes",
    "express",
    "typescript",
    "mongodb"
  ],
  "author": "Arfa Riaz",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.8.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@types/supertest": "^7.2.1",
    "chai": "^6.2.2",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "mocha": "^11.7.6",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "overrides": {
    "diff": "^8.0.2",
    "serialize-javascript": "^7.0.5"
  }
}
